<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Basisthema; de daadwerkelijke kleuren/typografie komen uit Compose
         (ui/theme/Theme.kt). Dit thema zorgt alleen voor een donkere
         achtergrond vóórdat Compose is opgestart (voorkomt een witte flits). -->
    <style name="Theme.Cryptora" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="android:windowBackground">#0B1220</item>
    </style>

    <!-- Opstartscherm-thema (AndroidX SplashScreen-compat, werkt ook onder
         Android 12): staat kort de Cryptora-badge (beeldmerk + eigen
         kaartje) op een donkere merk-achtergrond, terwijl MainActivity de
         eerste zoekopdracht-status opzet. Omdat de badge zijn eigen
         afgeronde-vierkant-kaartje al bevat in dezelfde kleur als deze
         achtergrond, versmelt de rand naadloos met het scherm en blijft
         vooral het beeldmerk zelf zichtbaar. Volgens de officiële aanpak van
         de library: een los thema met "Theme.SplashScreen" als parent,
         gekoppeld via postSplashScreenTheme aan het echte app-thema — zie
         MainActivity.installSplashScreen() en AndroidManifest.xml
         (android:theme op de MainActivity). -->
    <style name="Theme.Cryptora.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#0B1220</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_cryptora_badge</item>
        <item name="postSplashScreenTheme">@style/Theme.Cryptora</item>
    </style>
</resources>
